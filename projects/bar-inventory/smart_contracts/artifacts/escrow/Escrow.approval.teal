    // smart_contracts/escrow/contract.py:49
    // assert not self.funded, "already funded"
    intc_0 // 0
    bytec_0 // "funded"
    app_global_get_ex
    assert // check self.funded exists
    !
    assert // already funded
    // smart_contracts/escrow/contract.py:50
    // assert payment.sender == self.buyer, "only the buyer may fund"
