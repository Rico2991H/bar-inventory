    ==
    // smart_contracts/escrow/contract.py:51-53
    // assert (
    //     payment.receiver == Global.current_application_address
    // ), "payment must go to the escrow"
    assert // payment must go to the escrow
    // smart_contracts/escrow/contract.py:54
    // assert payment.amount == self.amount, "payment must equal the order amount"
    gtxns Amount
    intc_0 // 0
    bytec_2 // "amount"
    app_global_get_ex
    assert // check self.amount exists
    ==
    assert // payment must equal the order amount
    // smart_contracts/escrow/contract.py:55
    // self.funded = True
    bytec_0 // "funded"
    intc_1 // 1
    app_global_put
    // smart_contracts/escrow/contract.py:43
    // @abimethod
    intc_1 // 1
    return


