#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 0 1
    bytecblock "funded" "buyer" "amount" "released" "seller" "delivered"
    txn ApplicationID
    bnz main_after_if_else@2
    // smart_contracts/escrow/contract.py:27-28
    // # Global state — initialised to safe defaults; create() sets the real values.
    // self.buyer = Account()
    bytec_1 // "buyer"
    global ZeroAddress
    app_global_put
    // smart_contracts/escrow/contract.py:29
    // self.seller = Account()
    bytec 4 // "seller"
    global ZeroAddress
    app_global_put
    // smart_contracts/escrow/contract.py:30
    // self.amount = UInt64(0)
    bytec_2 // "amount"
    intc_0 // 0
    app_global_put
    // smart_contracts/escrow/contract.py:31
    // self.funded = False
    bytec_0 // "funded"
    intc_0 // 0
    app_global_put
    // smart_contracts/escrow/contract.py:32
    // self.delivered = False
    bytec 5 // "delivered"
    intc_0 // 0
    app_global_put
    // smart_contracts/escrow/contract.py:33
    // self.released = False
    bytec_3 // "released"
    intc_0 // 0
    app_global_put

main_after_if_else@2:
    // smart_contracts/escrow/contract.py:13
    // class Escrow(ARC4Contract):
    txn OnCompletion
    !
    assert
    txn ApplicationID
    bz main_create_NoOp@9
    pushbytess 0x51531b75 0xff4966a6 0x076bbd4d // method "fund(pay)void", method "confirm_delivery()void", method "release()void"
    txna ApplicationArgs 0
    match fund confirm_delivery release
    err

main_create_NoOp@9:
    // smart_contracts/escrow/contract.py:13
    // class Escrow(ARC4Contract):
    pushbytes 0xc0b64352 // method "create(address,uint64)void"
    txna ApplicationArgs 0
    match create
    err


// smart_contracts.escrow.contract.Escrow.create[routing]() -> void:
create:
    // smart_contracts/escrow/contract.py:35
    // @abimethod(create="require")
    txna ApplicationArgs 1
    dup
    len
    pushint 32
    ==
    assert // invalid number of bytes for arc4.static_array<arc4.uint8, 32>
    txna ApplicationArgs 2
    dup
    len
    pushint 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    // smart_contracts/escrow/contract.py:38
    // assert amount > 0, "amount must be positive"
    dup
    assert // amount must be positive
    // smart_contracts/escrow/contract.py:39
    // self.buyer = Txn.sender
    bytec_1 // "buyer"
    txn Sender
    app_global_put
    // smart_contracts/escrow/contract.py:40
    // self.seller = seller
    bytec 4 // "seller"
    uncover 2
    app_global_put
    // smart_contracts/escrow/contract.py:41
    // self.amount = amount
    bytec_2 // "amount"
    swap
    app_global_put
    // smart_contracts/escrow/contract.py:35
    // @abimethod(create="require")
    intc_1 // 1
    return


// smart_contracts.escrow.contract.Escrow.fund[routing]() -> void:
fund:
    // smart_contracts/escrow/contract.py:43
    // @abimethod
    txn GroupIndex
